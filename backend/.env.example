# VARIABLES DE ENTORNO PARA DESARROLLO LOCAL
# Copia este archivo como .env y completa los valores

# CONFIGURACIÓN DE LA BASE DE DATOS POSTGRESQL
DB_NAME=bbv_inversiones
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432

# CONFIGURACIÓN DE DJANGO PARA AUTENTICACIÓN CON GOOGLE
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# CREDENCIALES DE AWS (para biometría facial)
AWS_ACCESS_KEY_ID=tu_aws_access_key
AWS_SECRET_ACCESS_KEY=tu_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET_NAME=bbv-inversiones-biometrics

# GEMINI API — ChatBBV con inteligencia artificial
GEMINI_API_KEY=tu_gemini_api_key
